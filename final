```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>PrintFlow — Campus Printing & Delivery Platform</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', sans-serif; -webkit-tap-highlight-color: transparent; }
        body { background-color: #f1f5f9; }
        .tab-transition { transition: all 0.2s ease-in-out; }
    </style>
</head>
<body class="min-h-screen text-slate-900 flex flex-col items-center">

    <!-- APP CONTAINER (Mobile-First Centered App Shell) -->
    <div class="w-full max-w-md min-h-screen bg-slate-50 shadow-xl flex flex-col justify-between relative border-x border-slate-200/80">

        <!-- TOP STICKY PORTAL SWITCHER & HEADER -->
        <header class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-slate-200 px-4 pt-3 pb-3">
            <div class="flex items-center justify-between mb-2.5">
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 text-white flex items-center justify-center shadow-sm">
                        <i class="fa-solid fa-layer-group text-sm"></i>
                    </div>
                    <div>
                        <h1 class="font-extrabold text-base leading-none text-slate-900 tracking-tight">Print<span class="text-blue-600">Flow</span></h1>
                        <p id="portal-subtitle" class="text-[11px] text-slate-500 font-medium mt-0.5">Student Portal • PHP (₱)</p>
                    </div>
                </div>

                <div class="flex items-center gap-1.5">
                    <button onclick="downloadSelfHtml()" class="px-2.5 py-1.5 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 text-xs font-bold flex items-center gap-1 transition" title="Download index.html for GitHub">
                        <i class="fa-solid fa-download"></i>
                        <span>Save HTML</span>
                    </button>
                    <button onclick="toggleShareLinks()" class="px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold flex items-center gap-1 transition" title="Get Direct Links">
                        <i class="fa-solid fa-link text-blue-600"></i>
                    </button>
                    <button onclick="clearAllOrders()" class="p-1.5 rounded-lg bg-slate-100 hover:bg-rose-50 text-slate-400 hover:text-rose-600 text-xs transition" title="Reset Orders">
                        <i class="fa-solid fa-rotate-right"></i>
                    </button>
                </div>
            </div>

            <!-- Site Switcher: Site 1 (Student) vs Site 2 (Partner: Shop & Rider) -->
            <div class="grid grid-cols-2 gap-1 bg-slate-100 p-1 rounded-xl border border-slate-200/80 text-xs">
                <button onclick="switchSite('student')" id="site-btn-student"
                    class="py-2 rounded-lg font-bold bg-white text-blue-600 shadow-sm flex items-center justify-center gap-1.5 tab-transition">
                    <i class="fa-solid fa-user-graduate"></i>
                    <span>Student App</span>
                </button>
                <button onclick="switchSite('partner')" id="site-btn-partner"
                    class="py-2 rounded-lg font-semibold text-slate-600 hover:text-slate-900 flex items-center justify-center gap-1.5 relative tab-transition">
                    <i class="fa-solid fa-store"></i>
                    <span>Shop & Rider</span>
                    <span id="partner-alert-badge" class="hidden w-2 h-2 rounded-full bg-rose-500 animate-ping"></span>
                </button>
            </div>

            <!-- Collapsible Direct URL Share Drawer -->
            <div id="share-links-box" class="hidden mt-2.5 p-3 rounded-xl bg-slate-900 text-white text-xs space-y-2">
                <div class="flex items-center justify-between">
                    <span class="font-bold text-amber-400"><i class="fa-solid fa-share-nodes mr-1"></i>PrintFlow Direct Role Links</span>
                    <button onclick="toggleShareLinks()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <p class="text-[11px] text-slate-300">Share these URLs once hosted on GitHub Pages:</p>
                <div class="flex items-center justify-between bg-slate-800 px-2.5 py-1.5 rounded-lg">
                    <span class="truncate text-[11px] text-blue-300">?role=student (Student Portal)</span>
                    <button onclick="copyRoleUrl('student')" class="ml-2 px-2 py-0.5 bg-blue-600 rounded text-[10px] font-bold shrink-0">Copy</button>
                </div>
                <div class="flex items-center justify-between bg-slate-800 px-2.5 py-1.5 rounded-lg">
                    <span class="truncate text-[11px] text-amber-300">?role=shop (Print Shop Portal)</span>
                    <button onclick="copyRoleUrl('shop')" class="ml-2 px-2 py-0.5 bg-amber-500 text-slate-950 rounded text-[10px] font-bold shrink-0">Copy</button>
                </div>
                <div class="flex items-center justify-between bg-slate-800 px-2.5 py-1.5 rounded-lg">
                    <span class="truncate text-[11px] text-emerald-300">?role=rider (Delivery Rider Portal)</span>
                    <button onclick="copyRoleUrl('rider')" class="ml-2 px-2 py-0.5 bg-emerald-500 text-slate-950 rounded text-[10px] font-bold shrink-0">Copy</button>
                </div>
            </div>
        </header>

        <!-- TOAST NOTIFICATION BANNER -->
        <div id="app-toast" class="hidden fixed top-20 max-w-sm w-[90%] z-50 bg-slate-900 text-white px-4 py-3 rounded-2xl shadow-xl border border-slate-700 flex items-center gap-3 text-xs">
            <i class="fa-solid fa-bell text-amber-400 text-sm"></i>
            <span id="app-toast-msg" class="font-medium flex-1">Notification</span>
        </div>

        <!-- GOOGLE DRIVE MODAL / PICKER -->
        <div id="gdrive-modal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-end sm:items-center justify-center p-0 sm:p-4">
            <div class="bg-white w-full max-w-md rounded-t-3xl sm:rounded-2xl border border-slate-200 shadow-2xl p-5 space-y-4 max-h-[90vh] overflow-y-auto">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                    <div class="flex items-center gap-2.5">
                        <div class="w-9 h-9 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-600">
                            <i class="fa-brands fa-google-drive text-lg"></i>
                        </div>
                        <div>
                            <h3 class="text-sm font-extrabold text-slate-900">Attach from Google Drive</h3>
                            <p class="text-[11px] text-slate-500">Select from Drive App or paste a share link</p>
                        </div>
                    </div>
                    <button onclick="closeGDriveModal()" class="w-8 h-8 rounded-lg bg-slate-100 text-slate-500 hover:text-slate-900 flex items-center justify-center">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <!-- Option 1: Open Phone's Native Google Drive App via System Picker -->
                <div class="p-3.5 rounded-2xl bg-blue-50/70 border border-blue-200/80 space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-extrabold text-blue-950"><i class="fa-solid fa-mobile-screen-button mr-1.5 text-blue-600"></i>Option 1: Open Google Drive App</span>
                        <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-blue-100 text-blue-700">Fastest on Phone</span>
                    </div>
                    <p class="text-[11px] text-slate-600 leading-relaxed">
                        On Android & iOS, tapping below opens your phone's file chooser where you can tap <strong>Google Drive</strong> in the side menu to pick any PDF or Doc directly.
                    </p>
                    <button type="button" onclick="triggerNativeDrivePicker()"
                        class="w-full py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs shadow-sm flex items-center justify-center gap-2 transition">
                        <i class="fa-brands fa-google-drive"></i>
                        <span>Browse Google Drive on My Phone</span>
                    </button>
                </div>

                <!-- Option 2: Paste Google Drive / Docs Link -->
                <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
                    <span class="text-xs font-extrabold text-slate-800 block"><i class="fa-solid fa-link mr-1.5 text-emerald-600"></i>Option 2: Paste Google Drive / Docs Link</span>
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-600 mb-1">Google Drive Share URL</label>
                        <input id="inp-gdrive-url" type="url" placeholder="https://drive.google.com/file/d/..."
                            class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs font-medium focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-white">
                    </div>
                    <div class="grid grid-cols-2 gap-2.5">
                        <div>
                            <label class="block text-[11px] font-semibold text-slate-600 mb-1">Document Name</label>
                            <input id="inp-gdrive-name" type="text" placeholder="e.g. Lab_Report.pdf"
                                class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs font-medium focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-white">
                        </div>
                        <div>
                            <label class="block text-[11px] font-semibold text-slate-600 mb-1">Page Count</label>
                            <input id="inp-gdrive-pages" type="number" min="1" value="10"
                                class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs font-bold focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-white">
                        </div>
                    </div>
                    <button type="button" onclick="attachGDriveLink()"
                        class="w-full py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-sm flex items-center justify-center gap-1.5 transition">
                        <i class="fa-solid fa-check"></i>
                        <span>Attach Google Drive Link</span>
                    </button>
                </div>

                <!-- Option 3: Quick Recent Google Drive Files -->
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Or Pick from Recent Drive Cloud Files</span>
                        <a href="https://drive.google.com" target="_blank" rel="noopener" class="text-[11px] font-bold text-blue-600 hover:underline">Open drive.google.com ↗</a>
                    </div>
                    <div class="space-y-1.5" id="gdrive-sample-list">
                        <button type="button" onclick="selectCloudDriveFile('Thesis_Chapter_1_to_5.pdf', 42, '2.4 MB', 'https://drive.google.com/file/d/1PrintFlowThesisSample/view')"
                            class="w-full p-2.5 rounded-xl border border-slate-200 hover:border-emerald-500 hover:bg-emerald-50/30 flex items-center justify-between text-left transition">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <i class="fa-solid fa-file-pdf text-rose-500 text-base"></i>
                                <div class="min-w-0">
                                    <p class="text-xs font-bold text-slate-800 truncate">Thesis_Chapter_1_to_5.pdf</p>
                                    <p class="text-[10px] text-slate-500">My Drive • 42 Pages • 2.4 MB</p>
                                </div>
                            </div>
                            <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-1 rounded-lg shrink-0">Select</span>
                        </button>
                        <button type="button" onclick="selectCloudDriveFile('Engineering_Math_Reviewer.docx', 18, '840 KB', 'https://docs.google.com/document/d/1PrintFlowReviewerSample/edit')"
                            class="w-full p-2.5 rounded-xl border border-slate-200 hover:border-emerald-500 hover:bg-emerald-50/30 flex items-center justify-between text-left transition">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <i class="fa-solid fa-file-word text-blue-600 text-base"></i>
                                <div class="min-w-0">
                                    <p class="text-xs font-bold text-slate-800 truncate">Engineering_Math_Reviewer.docx</p>
                                    <p class="text-[10px] text-slate-500">Shared with me • 18 Pages • 840 KB</p>
                                </div>
                            </div>
                            <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-1 rounded-lg shrink-0">Select</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- MAIN CONTENT AREA -->
        <main class="flex-1 p-4 space-y-4 pb-20">

            <!-- ================================================================= -->
            <!-- SITE 1: STUDENT PORTAL                                            -->
            <!-- ================================================================= -->
            <div id="view-student" class="space-y-4">

                <!-- Student Sub-Navigation (New Order vs Active Orders) -->
                <div class="flex border-b border-slate-200 text-xs font-bold">
                    <button onclick="switchStudentSubTab('form')" id="stab-form" class="flex-1 pb-2.5 border-b-2 border-blue-600 text-blue-600">
                        1. Submit Print Order
                    </button>
                    <button onclick="switchStudentSubTab('track')" id="stab-track" class="flex-1 pb-2.5 border-b-2 border-transparent text-slate-500 flex items-center justify-center gap-1.5">
                        <span>2. My Orders</span>
                        <span id="student-order-badge" class="px-1.5 py-0.2 rounded-full text-[10px] bg-blue-100 text-blue-700">0</span>
                    </button>
                </div>

                <!-- STUDENT SUB-VIEW A: SUBMIT ORDER FORM -->
                <div id="student-subview-form" class="space-y-4">

                    <!-- Student & Working File Picker (Phone Storage + Google Drive) -->
                    <div class="bg-white p-4 rounded-2xl border border-slate-200/90 shadow-sm space-y-3.5">
                        <div class="flex items-center justify-between">
                            <h2 class="text-xs font-extrabold uppercase tracking-wider text-slate-500">1. Student & Document File</h2>
                            <span id="file-source-pill" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-blue-50 text-blue-700">Ready to Attach</span>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Student Name</label>
                            <input id="inp-student" type="text" placeholder="e.g. Juan Dela Cruz" value="Juan Dela Cruz"
                                class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>

                        <!-- Hidden Native File Inputs (Accepts any document or image from Phone or Drive Provider) -->
                        <input type="file" id="inp-file-local" class="hidden"
                            accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.txt,.jpg,.jpeg,.png,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/*"
                            onchange="handleLocalFilePick(event, 'Phone Storage')">
                        <input type="file" id="inp-file-gdrive-native" class="hidden"
                            accept="*/*"
                            onchange="handleLocalFilePick(event, 'Google Drive')">

                        <!-- Dual Source Picker Buttons: Local Phone vs Google Drive -->
                        <div class="space-y-2">
                            <label class="block text-xs font-semibold text-slate-700">Choose Document Source</label>
                            <div class="grid grid-cols-2 gap-2.5">
                                <!-- Button 1: Local Phone / Device Files -->
                                <button type="button" onclick="document.getElementById('inp-file-local').click()"
                                    class="p-3 rounded-xl border-2 border-dashed border-blue-400 bg-blue-50/40 hover:bg-blue-50 active:scale-[0.99] flex flex-col items-center justify-center text-center gap-1 transition">
                                    <div class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center shadow-xs">
                                        <i class="fa-solid fa-folder-open text-sm"></i>
                                    </div>
                                    <span class="text-xs font-bold text-slate-900">Phone / Files</span>
                                    <span class="text-[10px] text-slate-500">PDF, Word, PPT, Image</span>
                                </button>

                                <!-- Button 2: Google Drive Picker / Link -->
                                <button type="button" onclick="openGDriveModal()"
                                    class="p-3 rounded-xl border-2 border-dashed border-emerald-400 bg-emerald-50/40 hover:bg-emerald-50 active:scale-[0.99] flex flex-col items-center justify-center text-center gap-1 transition">
                                    <div class="w-8 h-8 rounded-lg bg-emerald-600 text-white flex items-center justify-center shadow-xs">
                                        <i class="fa-brands fa-google-drive text-sm"></i>
                                    </div>
                                    <span class="text-xs font-bold text-slate-900">Google Drive</span>
                                    <span class="text-[10px] text-slate-500">Drive App or Link</span>
                                </button>
                            </div>
                        </div>

                        <!-- Attached File Preview Card -->
                        <div id="attached-file-card" class="p-3 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-between gap-2.5">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <div id="attached-file-icon" class="w-9 h-9 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center shrink-0">
                                    <i class="fa-solid fa-file-pdf text-base"></i>
                            